rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function validInitialUser() {
      return request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'plan',
          'trialStart',
          'premiumUntil',
          'blocked',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'plan',
          'trialStart',
          'premiumUntil',
          'blocked',
          'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.plan == 'trial'
        && request.resource.data.trialStart is timestamp
        && request.resource.data.premiumUntil == null
        && request.resource.data.blocked == false
        && request.resource.data.createdAt is timestamp;
    }

    function validOwnerUserUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'displayName',
          'email',
          'updatedAt',
          'moneySettings',
          'moneySettingsUpdatedAt',
          'lastSignInAt',
          'lastSeenAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.get('moneySettings', {}) is map
        && request.resource.data.get(
          'updatedAt',
          request.time
        ) is timestamp
        && request.resource.data.get(
          'moneySettingsUpdatedAt',
          request.time
        ) is timestamp
        && request.resource.data.get(
          'lastSignInAt',
          request.time
        ) is timestamp
        && request.resource.data.get(
          'lastSeenAt',
          request.time
        ) is timestamp
        && (
          !changed.hasAny(['lastSignInAt'])
          || request.resource.data.lastSignInAt <= request.time
        )
        && (
          !changed.hasAny(['lastSeenAt'])
          || request.resource.data.lastSeenAt == request.time
        );
    }

    function validAdminAccessUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'plan',
          'premiumUntil',
          'blocked',
          'updatedAt',
          'accessUpdatedAt',
          'accessUpdatedBy'
        ])
        && changed.hasAny(['plan', 'premiumUntil', 'blocked'])
        && request.resource.data.blocked is bool
        && (
          !changed.hasAny(['plan', 'premiumUntil'])
          || (
            request.resource.data.plan == 'premium'
            && request.resource.data.premiumUntil is timestamp
            && request.resource.data.blocked == false
          )
          || (
            request.resource.data.plan == 'free'
            && request.resource.data.premiumUntil == null
          )
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.accessUpdatedAt is timestamp
        && request.resource.data.accessUpdatedBy == request.auth.uid;
    }

    function ownsCustomCategory() {
      return resource != null
        && signedIn()
        && resource.data.get('isDefault', true) == false
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function validCustomCategoryOwner() {
      return request.resource != null
        && request.resource.data.get('isDefault', true) == false
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function validCustomCategoryFields() {
      return request.resource != null
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('icon', '').size() <= 20
        && request.resource.data.get('color', '') is string
        && request.resource.data.get('color', '').size() <= 40
        && request.resource.data.get('type', '') is string
        && (
          request.resource.data.get('type', '') == 'income'
          || request.resource.data.get('type', '') == 'expense'
        );
    }

    function validSupportCreate(requestId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'protocol',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'protocol',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.protocol == requestId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.category is string
        && (
          request.resource.data.category == 'support'
          || request.resource.data.category == 'technical'
          || request.resource.data.category == 'billing'
          || request.resource.data.category == 'cancellation'
          || request.resource.data.category == 'privacy'
        )
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 4
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validSupportAdminUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'status',
          'response',
          'respondedAt',
          'updatedAt',
          'responderUid'
        ])
        && changed.hasAny(['status', 'response'])
        && request.resource.data.status is string
        && (
          request.resource.data.status == 'open'
          || request.resource.data.status == 'in_progress'
          || request.resource.data.status == 'answered'
          || request.resource.data.status == 'closed'
        )
        && request.resource.data.response is string
        && request.resource.data.response.size() >= 2
        && request.resource.data.response.size() <= 4000
        && request.resource.data.respondedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.responderUid == request.auth.uid;
    }

    function validNotificationSubscriber(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'enabled',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'enabled',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.enabled == true
        && request.resource.data.updatedAt is timestamp;
    }

    function validTransactionAmount() {
      return request.resource.data.get('amount', null) is number
        && request.resource.data.amount > -100000000
        && request.resource.data.amount < 100000000;
    }

    // Estorno integral único; a origem é imutável e sempre pertence ao UID.
    function validFullReversal(uid) {
      let data = request.resource.data;
      let source = /databases/$(database)/documents/users/$(uid)/invoiceEvents/$(data.reversesEventId);
      return data.reversesEventId.matches('^evt_[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$')
        && data.operationId == 'rev_' + data.reversesEventId
        && exists(source)
        && get(source).data.type == 'payment'
        && get(source).data.cardId == data.cardId
        && get(source).data.invoiceKey == data.invoiceKey
        && get(source).data.amount == data.amount
        && get(source).data.get('sourceAccount', '') == data.sourceAccount;
    }

    function validInvoiceEvent(eventId, uid) {
      let data = request.resource.data;
      let keys = data.keys();
      let common = [
        'operationId', 'type', 'invoiceKey', 'cardId', 'cardName',
        'cardLast4', 'invoiceMonth', 'eventDate', 'notes', 'createdAt'
      ];
      return keys.hasAll(common)
        && data.operationId is string
        && data.operationId == eventId
        && data.operationId.matches('^(rev_)?evt_[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$')
        && (data.type == 'reversal' || !data.operationId.matches('^rev_.*'))
        && data.cardId is string
        && data.cardId.size() > 0
        && data.cardId.size() <= 128
        && !data.cardId.matches('.*[/].*')
        && data.cardName is string
        && data.cardName.size() <= 120
        && data.cardLast4 is string
        && data.cardLast4.size() <= 8
        && data.invoiceMonth is string
        && data.invoiceMonth.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])$')
        && data.invoiceKey == data.cardId + ':' + data.invoiceMonth
        && data.eventDate is string
        && data.eventDate.matches('^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && data.notes is string
        && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && (
          (
            data.type == 'payment'
            && keys.hasOnly(common.concat(['amount', 'paymentDate', 'sourceAccount']))
            && keys.hasAll(['amount', 'paymentDate', 'sourceAccount'])
            && data.amount is number
            && data.amount > 0
            && data.amount <= 100000000
            && data.paymentDate == data.eventDate
            && data.sourceAccount is string
            && data.sourceAccount.size() <= 120
          ) || (
            data.type == 'adjustment'
            && keys.hasOnly(common.concat(['direction', 'signedAmount']))
            && keys.hasAll(['direction', 'signedAmount'])
            && data.direction in ['charge', 'credit']
            && data.signedAmount is number
            && data.signedAmount >= -100000000
            && data.signedAmount <= 100000000
            && (
              (data.direction == 'charge' && data.signedAmount > 0)
              || (data.direction == 'credit' && data.signedAmount < 0)
            )
            && data.notes.size() > 0
          ) || (
            data.type == 'reversal'
            && keys.hasOnly(common.concat(['amount', 'reversesEventId', 'sourceAccount']))
            && keys.hasAll(['amount', 'reversesEventId', 'sourceAccount'])
            && data.amount is number
            && data.amount > 0
            && data.amount <= 100000000
            && data.reversesEventId is string
            && data.reversesEventId.size() > 0
            && data.reversesEventId.size() <= 128
            && validFullReversal(uid)
            && data.sourceAccount is string
            && data.sourceAccount.size() <= 120
          ) || (
            data.type == 'manual_close'
            && keys.hasOnly(common)
          )
        );
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();

      allow create: if owner(uid) && validInitialUser();

      allow update: if (owner(uid) && validOwnerUserUpdate()) || (admin() && validAdminAccessUpdate());

      allow delete: if false;

      // Comprovantes fragmentados: isolados por usuário, imutáveis após gravação,
      // com tamanho e vínculo a uma transação existente validados no servidor.
      match /transactionAttachmentChunks/{chunkId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasAll(['txId', 'attachmentId', 'chunkIndex', 'data'])
          && request.resource.data.keys().hasOnly(['txId', 'attachmentId', 'chunkIndex', 'data'])
          && request.resource.data.txId is string
          && request.resource.data.txId.size() > 0
          && request.resource.data.txId.size() <= 128
          && request.resource.data.attachmentId is string
          && request.resource.data.attachmentId.size() > 0
          && request.resource.data.attachmentId.size() <= 128
          && request.resource.data.chunkIndex is int
          && request.resource.data.chunkIndex >= 0
          && request.resource.data.chunkIndex <= 12
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 270000
          && exists(/databases/$(database)/documents/users/$(uid)/transactions/$(request.resource.data.txId));
        allow update: if false;
        allow delete: if owner(uid);
      }

      match /invoiceEvents/{eventId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validInvoiceEvent(eventId, uid);
        allow update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && validTransactionAmount();
        allow update: if owner(uid)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
            || validTransactionAmount()
          );
      }

      match /{collection}/{document=**} {
        allow read, write: if owner(uid)
          && collection != 'transactionAttachmentChunks'
          && collection != 'invoiceEvents'
          && collection != 'transactions';
      }
    }

    match /categories/{categoryId} {
      allow read: if admin()
        || (
          signedIn()
          && (
            resource.data.isDefault == true
            || resource.data.ownerUid == request.auth.uid
          )
        );

      allow create: if admin()
        || (
          signedIn()
          && validCustomCategoryOwner()
          && validCustomCategoryFields()
        );

      allow update: if admin()
        || (
          ownsCustomCategory()
          && validCustomCategoryOwner()
          && validCustomCategoryFields()
        );

      allow delete: if admin() || ownsCustomCategory();
    }

    match /adminAudit/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /supportRequests/{requestId} {
      allow create: if signedIn() && validSupportCreate(requestId);
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin() && validSupportAdminUpdate();
      allow delete: if false;
    }

    match /notificationSubscribers/{uid} {
      allow read: if owner(uid);

      allow create, update: if owner(uid)
        && validNotificationSubscriber(uid);

      allow delete: if owner(uid);
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /privacyConsents/{consentId} {
      allow read: if admin();
      allow write: if false;
    }

    match /accountDeletionRequests/{uid} {
      allow read: if admin();
      allow write: if false;
    }

    match /privacyAudit/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
