rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function validInitialUser() {
      return request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'plan',
          'trialStart',
          'premiumUntil',
          'blocked',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'plan',
          'trialStart',
          'premiumUntil',
          'blocked',
          'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.plan == 'trial'
        && request.resource.data.trialStart is timestamp
        && request.resource.data.premiumUntil == null
        && request.resource.data.blocked == false
        && request.resource.data.createdAt is timestamp;
    }

    function validOwnerUserUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'displayName',
          'email',
          'updatedAt',
          'moneySettings',
          'moneySettingsUpdatedAt',
          'lastSignInAt',
          'lastSeenAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.get('moneySettings', {}) is map
        && request.resource.data.get(
          'updatedAt',
          request.time
        ) is timestamp
        && request.resource.data.get(
          'moneySettingsUpdatedAt',
          request.time
        ) is timestamp
        && request.resource.data.get(
          'lastSignInAt',
          request.time
        ) is timestamp
        && request.resource.data.get(
          'lastSeenAt',
          request.time
        ) is timestamp
        && (
          !changed.hasAny(['lastSignInAt'])
          || request.resource.data.lastSignInAt <= request.time
        )
        && (
          !changed.hasAny(['lastSeenAt'])
          || request.resource.data.lastSeenAt == request.time
        );
    }

    function validAdminAccessUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'plan',
          'premiumUntil',
          'blocked',
          'updatedAt',
          'accessUpdatedAt',
          'accessUpdatedBy'
        ])
        && changed.hasAny(['plan', 'premiumUntil', 'blocked'])
        && request.resource.data.blocked is bool
        && (
          !changed.hasAny(['plan', 'premiumUntil'])
          || (
            request.resource.data.plan == 'premium'
            && request.resource.data.premiumUntil is timestamp
            && request.resource.data.blocked == false
          )
          || (
            request.resource.data.plan == 'free'
            && request.resource.data.premiumUntil == null
          )
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.accessUpdatedAt is timestamp
        && request.resource.data.accessUpdatedBy == request.auth.uid;
    }

    function ownsCustomCategory() {
      return resource != null
        && signedIn()
        && resource.data.get('isDefault', true) == false
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function validCustomCategoryOwner() {
      return request.resource != null
        && request.resource.data.get('isDefault', true) == false
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function validCustomCategoryFields() {
      return request.resource != null
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 0
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('icon', '') is string
        && request.resource.data.get('icon', '').size() <= 20
        && request.resource.data.get('color', '') is string
        && request.resource.data.get('color', '').size() <= 40
        && request.resource.data.get('type', '') is string
        && (
          request.resource.data.get('type', '') == 'income'
          || request.resource.data.get('type', '') == 'expense'
        );
    }

    function validSupportCreate(requestId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'email',
          'protocol',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'protocol',
          'category',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.protocol == requestId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.category is string
        && (
          request.resource.data.category == 'support'
          || request.resource.data.category == 'technical'
          || request.resource.data.category == 'billing'
          || request.resource.data.category == 'cancellation'
          || request.resource.data.category == 'privacy'
        )
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 4
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validSupportAdminUpdate() {
      let changed =
        request.resource.data.diff(resource.data).affectedKeys();

      return changed.hasOnly([
          'status',
          'response',
          'respondedAt',
          'updatedAt',
          'responderUid'
        ])
        && changed.hasAny(['status', 'response'])
        && request.resource.data.status is string
        && (
          request.resource.data.status == 'open'
          || request.resource.data.status == 'in_progress'
          || request.resource.data.status == 'answered'
          || request.resource.data.status == 'closed'
        )
        && request.resource.data.response is string
        && request.resource.data.response.size() >= 2
        && request.resource.data.response.size() <= 4000
        && request.resource.data.respondedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.responderUid == request.auth.uid;
    }

    function validNotificationSubscriber(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'enabled',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'enabled',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.enabled == true
        && request.resource.data.updatedAt is timestamp;
    }

    // Novo evento: ID estável, schema fechado e histórico imutável.
    function validInvoiceEventMoney(amount) {
      return amount is number
        && amount > 0
        && amount <= 100000000
        && math.abs(amount * 100 - math.round(amount * 100)) < 0.00001;
    }

    function validInvoiceEventDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validInvoiceEventDetails(uid, data) {
      return (
          data.type == 'payment'
          && data.keys().hasAll(['amount', 'paymentDate', 'sourceAccount'])
          && !data.keys().hasAny(['direction', 'signedAmount', 'reversesEventId'])
          && validInvoiceEventMoney(data.amount)
          && data.paymentDate == data.eventDate
          && data.sourceAccount is string
          && data.sourceAccount.size() <= 120
        )
        || (
          data.type == 'adjustment'
          && data.keys().hasAll(['signedAmount', 'direction'])
          && !data.keys().hasAny(['amount', 'paymentDate', 'sourceAccount', 'reversesEventId'])
          && data.signedAmount is number
          && data.signedAmount != 0
          && data.signedAmount >= -100000000
          && data.signedAmount <= 100000000
          && math.abs(data.signedAmount * 100 - math.round(data.signedAmount * 100)) < 0.00001
          && (data.direction == 'credit' || data.direction == 'charge')
          && (
            (data.direction == 'credit' && data.signedAmount < 0)
            || (data.direction == 'charge' && data.signedAmount > 0)
          )
          && data.notes.size() > 0
        )
        || (
          data.type == 'reversal'
          && data.keys().hasAll(['amount', 'reversesEventId', 'sourceAccount'])
          && !data.keys().hasAny(['direction', 'signedAmount', 'paymentDate'])
          && validInvoiceEventMoney(data.amount)
          && data.reversesEventId is string
          && data.reversesEventId.size() > 0
          && data.reversesEventId.size() <= 128
          && data.sourceAccount is string
          && data.sourceAccount.size() <= 120
          && exists(/databases/$(database)/documents/users/$(uid)/invoiceEvents/$(data.reversesEventId))
          && get(/databases/$(database)/documents/users/$(uid)/invoiceEvents/$(data.reversesEventId)).data.type == 'payment'
          && get(/databases/$(database)/documents/users/$(uid)/invoiceEvents/$(data.reversesEventId)).data.invoiceKey == data.invoiceKey
          && data.amount <= get(/databases/$(database)/documents/users/$(uid)/invoiceEvents/$(data.reversesEventId)).data.amount
        )
        || (
          data.type == 'manual_close'
          && !data.keys().hasAny([
            'amount', 'paymentDate', 'sourceAccount', 'signedAmount', 'direction', 'reversesEventId'
          ])
        );
    }

    // Uma única nova operação de estorno poderá ocupar a trava do pagamento.
    // O documento de evento e a trava precisam nascer na mesma transação.
    function validInvoiceReversalEventLock(uid, eventId, data) {
      let lockPath = /databases/$(database)/documents/users/$(uid)/invoiceReversalLocks/$(data.reversesEventId);

      return !exists(lockPath)
        && getAfter(lockPath).data.paymentId == data.reversesEventId
        && getAfter(lockPath).data.reversalEventId == eventId
        && getAfter(lockPath).data.invoiceKey == data.invoiceKey
        && getAfter(lockPath).data.amountCents == math.round(data.amount * 100);
    }

    function validInvoiceReversalLockCreate(uid, paymentId) {
      let data = request.resource.data;
      let paymentPath = /databases/$(database)/documents/users/$(uid)/invoiceEvents/$(paymentId);
      let reversalPath = /databases/$(database)/documents/users/$(uid)/invoiceEvents/$(data.reversalEventId);

      return data.keys().hasAll([
          'paymentId', 'reversalEventId', 'invoiceKey', 'amountCents', 'createdAt'
        ])
        && data.keys().hasOnly([
          'paymentId', 'reversalEventId', 'invoiceKey', 'amountCents', 'createdAt'
        ])
        && data.paymentId == paymentId
        && data.reversalEventId is string
        && data.reversalEventId.size() <= 64
        && data.reversalEventId.matches(
          '^op_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
        )
        && data.invoiceKey is string
        && data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 10000000000
        && data.createdAt == request.time
        && exists(paymentPath)
        && get(paymentPath).data.type == 'payment'
        && get(paymentPath).data.invoiceKey == data.invoiceKey
        && data.amountCents <= math.round(get(paymentPath).data.amount * 100)
        && !exists(reversalPath)
        && getAfter(reversalPath).data.type == 'reversal'
        && getAfter(reversalPath).data.reversesEventId == paymentId
        && getAfter(reversalPath).data.invoiceKey == data.invoiceKey
        && data.amountCents == math.round(getAfter(reversalPath).data.amount * 100);
    }

    function validInvoiceEventCreate(uid, eventId) {
      let data = request.resource.data;

      return data.keys().hasAll([
          'type', 'operationId', 'invoiceKey', 'cardId', 'cardName',
          'cardLast4', 'invoiceMonth', 'eventDate', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'type', 'operationId', 'invoiceKey', 'cardId', 'cardName',
          'cardLast4', 'invoiceMonth', 'eventDate', 'notes', 'createdAt',
          'paymentDate', 'amount', 'sourceAccount', 'signedAmount',
          'direction', 'reversesEventId'
        ])
        && data.operationId is string
        && data.operationId.matches(
          '^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
        )
        && eventId == 'op_' + data.operationId
        && data.cardId is string
        && data.cardId.size() > 0
        && data.cardId.size() <= 128
        && exists(/databases/$(database)/documents/users/$(uid)/creditCards/$(data.cardId))
        && data.cardName is string
        && data.cardName.size() <= 120
        && data.cardLast4 is string
        && data.cardLast4.size() <= 4
        && data.invoiceMonth is string
        && data.invoiceMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.invoiceKey == data.cardId + ':' + data.invoiceMonth
        && data.notes is string
        && data.notes.size() <= 2000
        && validInvoiceEventDate(data.eventDate)
        && data.createdAt == request.time
        && validInvoiceEventDetails(uid, data)
        && (
          data.type != 'reversal'
          || validInvoiceReversalEventLock(uid, eventId, data)
        );
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();

      allow create: if owner(uid) && validInitialUser();

      allow update: if (owner(uid) && validOwnerUserUpdate()) || (admin() && validAdminAccessUpdate());

      allow delete: if false;

      // Comprovantes fragmentados: isolados por usuário, imutáveis após gravação,
      // com tamanho e vínculo a uma transação existente validados no servidor.
      match /transactionAttachmentChunks/{chunkId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasAll(['txId', 'attachmentId', 'chunkIndex', 'data'])
          && request.resource.data.keys().hasOnly(['txId', 'attachmentId', 'chunkIndex', 'data'])
          && request.resource.data.txId is string
          && request.resource.data.txId.size() > 0
          && request.resource.data.txId.size() <= 128
          && request.resource.data.attachmentId is string
          && request.resource.data.attachmentId.size() > 0
          && request.resource.data.attachmentId.size() <= 128
          && request.resource.data.chunkIndex is int
          && request.resource.data.chunkIndex >= 0
          && request.resource.data.chunkIndex <= 12
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 270000
          && exists(/databases/$(database)/documents/users/$(uid)/transactions/$(request.resource.data.txId));
        allow update: if false;
        allow delete: if owner(uid);
      }

      // Leituras históricas permanecem; só novas criações validadas são aceitas.
      match /invoiceEvents/{eventId} {
        allow get, list: if owner(uid);
        allow create: if owner(uid) && validInvoiceEventCreate(uid, eventId);
        allow update, delete: if false;
      }

      // A trava impede várias novas operações sobre um único pagamento,
      // mesmo quando cada evento usa um UUID diferente.
      match /invoiceReversalLocks/{paymentId} {
        allow get: if owner(uid);
        allow list: if false;
        allow create: if owner(uid) && validInvoiceReversalLockCreate(uid, paymentId);
        allow update, delete: if false;
      }

      match /{collection}/{document=**} {
        allow read, write: if owner(uid)
          && collection != 'transactionAttachmentChunks'
          && collection != 'invoiceEvents'
          && collection != 'invoiceReversalLocks';
      }
    }

    match /categories/{categoryId} {
      allow read: if admin()
        || (
          signedIn()
          && (
            resource.data.isDefault == true
            || resource.data.ownerUid == request.auth.uid
          )
        );

      allow create: if admin()
        || (
          signedIn()
          && validCustomCategoryOwner()
          && validCustomCategoryFields()
        );

      allow update: if admin()
        || (
          ownsCustomCategory()
          && validCustomCategoryOwner()
          && validCustomCategoryFields()
        );

      allow delete: if admin() || ownsCustomCategory();
    }

    match /adminAudit/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /supportRequests/{requestId} {
      allow create: if signedIn() && validSupportCreate(requestId);
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin() && validSupportAdminUpdate();
      allow delete: if false;
    }

    match /notificationSubscribers/{uid} {
      allow read: if owner(uid);

      allow create, update: if owner(uid)
        && validNotificationSubscriber(uid);

      allow delete: if owner(uid);
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /privacyConsents/{consentId} {
      allow read: if admin();
      allow write: if false;
    }

    match /accountDeletionRequests/{uid} {
      allow read: if admin();
      allow write: if false;
    }

    match /privacyAudit/{auditId} {
      allow read: if admin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
