{
  "name": "meu-real",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://fhenriquefcruz.github.io/cfp-money",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run test && npm run build",
    "functions:install": "npm install --prefix functions",
    "functions:test": "npm run test --prefix functions",
    "functions:validate": "npm run validate --prefix functions",
    "validate:all": "npm run validate && npm run functions:validate && npm run validate:indexes && npm run notifications:validate",
    "emulators": "firebase emulators:start",
    "deploy:backend": "firebase deploy --only functions",
    "deploy:firebase": "firebase deploy --only firestore,functions",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "validate:indexes": "node scripts/validate-firestore-indexes.mjs",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "notifications:test": "npm run test --prefix worker/email-notifications",
    "notifications:validate": "npm run validate --prefix worker/email-notifications",
    "notifications:install": "npm install --prefix worker/email-notifications",
    "notifications:dev": "npm run dev --prefix worker/email-notifications",
    "notifications:deploy": "npm run deploy --prefix worker/email-notifications"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "firebase": "^10.8.0",
    "framer-motion": "^11.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.330.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "autoprefixer": "^10.4.17",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "gh-pages": "^6.1.1",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.1",
    "vite": "^8.1.5",
    "vitest": "^3.0.0"
  }
}
