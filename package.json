{
  "name": "meu-real",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://fhenriquefcruz.github.io/cfp-money",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-service-worker.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run test && npm run build",
    "functions:install": "npm install --prefix functions",
    "functions:test": "npm run test --prefix functions",
    "functions:validate": "npm run validate --prefix functions",
    "validate:all": "npm run validate && npm run functions:validate && npm run validate:indexes && npm run notifications:validate && npm run validate:pwa && npm run validate:responsive && npm run check:performance",
    "emulators": "firebase emulators:start",
    "deploy:backend": "firebase deploy --only functions",
    "deploy:firebase": "firebase deploy --only firestore,functions",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "validate:indexes": "node scripts/validate-firestore-indexes.mjs",
    "validate:pwa": "node scripts/validate-pwa.mjs",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "notifications:test": "npm run test --prefix worker/email-notifications",
    "notifications:validate": "npm run validate --prefix worker/email-notifications",
    "notifications:install": "npm install --prefix worker/email-notifications",
    "notifications:dev": "npm run dev --prefix worker/email-notifications",
    "notifications:deploy": "npm run deploy --prefix worker/email-notifications",
    "validate:responsive": "node scripts/validate-responsive-ui.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test --config=playwright.accessibility.config.js",
    "test:a11y:headed": "playwright test --config=playwright.accessibility.config.js --headed",
    "test:a11y:report": "playwright show-report playwright-a11y-report",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "validate:performance": "npm run build && npm run check:performance",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:pwa:headed": "playwright test --config=playwright.pwa.config.js --headed",
    "test:pwa:report": "playwright show-report playwright-pwa-report",
    "test:security-runtime": "vitest run src/config/securityRuntime.test.js",
    "test:rules": "firebase emulators:exec --project demo-cfp-money-security --only firestore \"node --test tests/security/firestore.rules.test.js\"",
    "validate:security-config": "node scripts/validate-security-config.mjs",
    "validate:security": "npm run validate:security-config && npm run validate:production-audit && npm run test:security-runtime && npm run test:rules",
    "validate:production-audit": "node scripts/validate-production-audit.mjs",
    "backup:create": "node functions/tools/sparkBackup.js",
    "backup:restore": "node functions/tools/sparkRestore.js",
    "test:backup-recovery": "firebase emulators:exec --project demo-cfp-money-backup --only firestore \"node functions/tools/testBackupRecovery.js\"",
    "validate:commercial": "node scripts/validate-commercial-readiness.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "firebase": "10.14.1",
    "framer-motion": "^11.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.330.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.2",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "3.0.4",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "autoprefixer": "^10.4.17",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "firebase-tools": "15.24.0",
    "gh-pages": "^6.1.1",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "8.5.26",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.1",
    "vite": "^8.1.5",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
